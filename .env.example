NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://algorico:algorico@localhost:5433/algorico

# App
APP_TIMEZONE=America/Argentina/Buenos_Aires
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Authentication / cookies
# Use at least 32 random characters in every environment.
SESSION_SECRET=replace-with-a-long-random-session-secret
SESSION_TTL_MS=604800000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=algorico
MINIO_SECRET_KEY=algorico_dev_secret
MINIO_BUCKET=algorico
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
PRESIGNED_URL_EXPIRES_SECONDS=300
MAX_UPLOAD_BYTES=10485760
STORAGE_DRIVER=minio
